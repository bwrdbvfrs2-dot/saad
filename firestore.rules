rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // "مدير" only, looked up from a small dedicated collection keyed by the real Firebase Auth
    // uid — kept separate from shop/state itself so this check never has to parse the big
    // document it is protecting.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "مدير";
    }

    // public, read-only username -> synthetic-login-email directory. Contains no passwords and
    // no shop data — only lets the login screen resolve which Firebase Auth account to sign into
    // from the username the person typed, so the login UI itself never has to change.
    match /usernames/{username} {
      allow get, list: if true;
      // anyone signed in may claim their OWN just-created account's username once (bootstrap and
      // normal "add employee" both go through this); it can never be taken over once it exists.
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username));
      // renaming/removing a login name is an admin action (keeps it in step with state.users)
      allow update, delete: if isAdmin();
    }

    // role lookup used by isAdmin() above. A user may create their OWN "مدير" role document only
    // while shop/state does not exist yet (the one-time first-account bootstrap); every other
    // role assignment — including granting admin to anyone else afterward — is itself an
    // admin-only write, which keeps privilege escalation out of reach of every other role.
    match /roles/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == "مدير"
        && !exists(/databases/$(database)/documents/shop/state);
      allow create, update, delete: if isAdmin();
    }

    // every save of shop/state must carry, in the same transaction, its entry in writeLog — made by
    // the signed-in account itself, stamped with the server's own time. A save without one is refused.
    function writeLogged(rev) {
      let entry = /databases/$(database)/documents/writeLog/$(string(rev));
      return existsAfter(entry) && getAfter(entry).data.uid == request.auth.uid;
    }

    match /shop/state {
      // an unauthenticated client may only ever learn whether this document exists yet — never
      // its contents — which is what lets the app show "first-time setup" vs "login" correctly
      // without needing anonymous auth at all.
      allow get: if isSignedIn() || resource == null;
      allow list: if isSignedIn();
      // creating it for the very first time is allowed to any signed-in client (there is nothing
      // to protect yet); once it exists this branch can never fire again.
      allow create: if isSignedIn() && resource == null;
      allow delete: if false;
      allow update: if isSignedIn()
        && (isAdmin() || (
          request.resource.data.users == resource.data.users
          && request.resource.data.permissions == resource.data.permissions
        ))
        && request.resource.data._rev == resource.data.get('_rev', 0) + 1
        && writeLogged(request.resource.data._rev);
    }

    // the mandatory write log: one entry per save, keyed by the revision it produced. Only created
    // together with that very save, never edited or removed (not even by the manager); only the
    // manager reads it.
    match /writeLog/{rev} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && string(request.resource.data.rev) == rev
        && getAfter(/databases/$(database)/documents/shop/state).data._rev == request.resource.data.rev;
      allow update, delete: if false;
    }

    // append-only activity trail — every signed-in user may add an entry, nobody may edit or
    // remove one after the fact (including admins), so it stays trustworthy as a tamper record.
    // An entry always carries the real account that wrote it and the server's time, so it can't be
    // written in someone else's name or back-dated. Only the manager reads the trail.
    match /auditLog/{entry} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // وطني بوت — kept out of shop/state. Leads and the bot settings are the manager's; bot_contacts is the
    // outreach record (contacted / opted out) and is written only by the server (Cloud Functions use the
    // Admin SDK, which these rules don't apply to), so no client — not even the manager — can forge it.
    match /leads/{mobile} {
      allow read, write: if isAdmin();
    }
    match /bot/{doc} {
      allow read, write: if isAdmin();
    }
    // outreach state per number — written by the server (Admin SDK bypasses these rules). The manager may
    // only clear the "needs a person" flag after handling the conversation.
    match /bot_contacts/{mobile} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsHuman', 'needsHumanClearedAt', 'needsHumanClearedBy'])
        && request.resource.data.needsHuman == false;
      allow create, delete: if false;
    }
    // the WhatsApp conversations and the daily send runs — server-written, manager-read
    match /bot_conversations/{mobile}/messages/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /bot_runs/{run} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // daily state snapshots for disaster recovery. Any signed-in user makes the day's backup (stamped
    // with their account and the server's time), nobody can change one, and only the manager can
    // remove old ones — so an employee can't wipe the backups.
    match /backups/{date} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.backedUpAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
